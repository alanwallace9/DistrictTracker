    <pattern name="Audit Logging">
      <description>How audit events are logged (for reference)</description>
      <source>app/actions/daep/points.ts</source>
      <code><![CDATA[
async function logPointsAuditEvent(
  supabase: Awaited<ReturnType<typeof createServerClient>>,
  eventType: string,
  actorId: string,
  targetId: string,
  action: string,
  tenantId: string,
  details?: Record<string, unknown>
): Promise<void> {
  try {
    await supabase.from('admin_audit_log').insert({
      event_type: eventType,
      actor_id: actorId,
      target_id: targetId,
      action,
      tenant_id: tenantId,
      module: 'daep_management',
      details,
    });
  } catch (error) {
    console.error('Failed to log points audit event:', error);
  }
}
      ]]></code>
    </pattern>
