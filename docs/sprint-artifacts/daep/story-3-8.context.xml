  <!-- ============================================ -->
  <database-schema>
    <table name="admin_audit_log" existing="true">
      <description>
        Existing table that stores all audit events. No new tables needed for this story.
      </description>
      <columns>
        <column name="id" type="UUID" pk="true">Primary key</column>
        <column name="event_type" type="TEXT">Event identifier (e.g., 'points.approved_by_admin')</column>
        <column name="actor_id" type="TEXT">Clerk user ID who performed action</column>
        <column name="actor_email" type="TEXT">Email of actor (for display)</column>
        <column name="actor_role" type="TEXT">Role at time of action</column>
        <column name="target_id" type="TEXT">Usually placement_id for DAEP events</column>
        <column name="action" type="TEXT">Human-readable action description</column>
        <column name="details" type="JSONB">Event-specific data (dates, values, before/after)</column>
        <column name="tenant_id" type="TEXT">Multi-tenancy filter</column>
        <column name="module" type="TEXT">Module: 'daep_management' or 'trespass_tracker'</column>
        <column name="record_subject_name" type="TEXT">Student name for FERPA searches</column>
        <column name="record_school_id" type="TEXT">Student school_id for student-level queries</column>
        <column name="created_at" type="TIMESTAMPTZ">Event timestamp</column>
      </columns>
      <indexes>
        <index>idx_admin_audit_log_actor ON (actor_id)</index>
        <index>idx_admin_audit_log_created ON (created_at DESC)</index>
        <index>idx_admin_audit_log_event_type ON (event_type)</index>
        <index>idx_admin_audit_log_target ON (target_id)</index>
        <index>idx_audit_log_tenant ON (tenant_id)</index>
      </indexes>
      <rls-policies>
        - "Master and district admins can view audit logs" - SELECT for super_admin, district_admin
        - "Authenticated users can insert audit logs" - INSERT for all authenticated
      </rls-policies>
    </table>

    <query-patterns>
      <pattern name="student-level">
        <description>All audit entries across all placements for a student</description>
        <sql><![CDATA[
SELECT * FROM admin_audit_log
WHERE tenant_id = $1
  AND module = 'daep_management'
  AND (target_id = ANY($2) OR record_school_id = $3)  -- placement IDs or student ID
ORDER BY created_at DESC
LIMIT 20 OFFSET $4;
        ]]></sql>
      </pattern>
      <pattern name="placement-level">
        <description>All audit entries for a specific placement</description>
        <sql><![CDATA[
SELECT * FROM admin_audit_log
WHERE tenant_id = $1
  AND module = 'daep_management'
  AND target_id = $2  -- specific placement_id
ORDER BY created_at DESC
LIMIT 20 OFFSET $3;
        ]]></sql>
      </pattern>
    </query-patterns>
  </database-schema>

